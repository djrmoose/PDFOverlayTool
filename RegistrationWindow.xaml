<Window x:Class="PdfOverlayTool.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome"
        Icon="/Resources/OCT.ico"
        Width="540"
        Height="Auto"
        SizeToContent="Height"
        MinWidth="480"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="BodyBrush" Color="#4A3F35"/>
        </Window.Resources>

        <Grid Margin="24">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Row="0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1"
                           Text="Brought to you by Bluemoose™"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="{DynamicResource BodyBrush}"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2"
                           FontSize="13"
                           Foreground="{DynamicResource BodyBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,12"
                           Text="Please enter your name and email for beta support. Anonymous usage data (settings, session activity, and file statistics without file names) is sent automatically as described in the terms below."/>

                <TextBlock x:Name="TermsTitleTextBlock"
                           Grid.Row="3"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6"/>

                <Border Grid.Row="4"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,12"
                        MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="10">
                                <TextBlock x:Name="TermsTextBlock"
                                           FontSize="12"
                                           Foreground="{DynamicResource BodyBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                        </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="5"
                           FontSize="12"
                           Foreground="{DynamicResource BodyBrush}"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap">
                        <Run Text="Third-party components remain subject to their own licenses. "/>
                        <Hyperlink Click="ThirdPartyNoticesLink_Click">View Third-Party Notices</Hyperlink>
                        <Run Text="."/>
                </TextBlock>

                <Grid x:Name="AcceptTermsPanel"
                      Grid.Row="6"
                      Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AcceptTermsCheckBox"
                                  Grid.Column="0"
                                  VerticalAlignment="Top"
                                  Margin="0,2,6,0"
                                  Checked="AcceptTermsCheckBox_Changed"
                                  Unchecked="AcceptTermsCheckBox_Changed"/>
                        <TextBlock x:Name="AcceptTermsTextBlock"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="AcceptTermsTextBlock_MouseLeftButtonDown"
                                   Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <TextBlock Grid.Row="7"
                           Text="Name"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>

                <TextBox x:Name="NameTextBox"
                         Grid.Row="8"
                         Margin="0,0,0,12"
                         Padding="6,4"
                         FontSize="13"/>

                <TextBlock Grid.Row="9"
                           Text="Email"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>

                <TextBox x:Name="EmailTextBox"
                         Grid.Row="10"
                         Margin="0,0,0,8"
                         Padding="6,4"
                         FontSize="13"/>

                <TextBlock x:Name="ValidationTextBlock"
                           Grid.Row="11"
                           Foreground="Red"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="12"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button x:Name="ContinueButton"
                                Content="Continue"
                                Width="100"
                                IsDefault="True"
                                IsEnabled="False"
                                Click="Continue_Click"/>
                </StackPanel>
        </Grid>
</Window>
