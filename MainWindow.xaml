<Window x:Class="PdfOverlayTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Compare Tool"
        Icon="/Resources/OCT.ico"
        Height="850"
        Width="1200"
        MinHeight="600"
        MinWidth="900">

        <Window.Resources>
                <Style TargetType="Button">
                        <Setter Property="Background" Value="#F4F4F4"/>
                        <Setter Property="Foreground" Value="#222222"/>
                        <Setter Property="BorderBrush" Value="#A6A6A6"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="8,3"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="OuterBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                        <Border x:Name="InnerBorder"
                                                                Margin="1"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="3"
                                                                BorderBrush="#D0D0D0"
                                                                BorderThickness="1">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="OuterBorder" Property="Background" Value="#E8E8E8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="OuterBorder" Property="Margin" Value="1,2,1,0"/>
                                                                <Setter TargetName="InnerBorder" Property="Margin" Value="0"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.4"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <Style x:Key="ProminentSliderStyle"
                       TargetType="Slider">
                        <Setter Property="Foreground"
                                Value="#4A4A4A"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                                <Grid>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TickBar x:Name="TopTick"
                                                                 Grid.Row="0"
                                                                 Fill="#6B6B6B"
                                                                 Placement="Top"
                                                                 Height="8"
                                                                 Visibility="Collapsed"/>

                                                        <Border Grid.Row="1"
                                                                Height="6"
                                                                CornerRadius="3"
                                                                Background="#CFCFCF"
                                                                VerticalAlignment="Center"/>

                                                        <Track x:Name="PART_Track"
                                                               Grid.Row="1">
                                                                <Track.Thumb>
                                                                        <Thumb Width="12"
                                                                               Height="12"
                                                                               Background="#D8D8D8"
                                                                               BorderBrush="#777777"
                                                                               BorderThickness="1"/>
                                                                </Track.Thumb>
                                                        </Track>

                                                        <TickBar x:Name="BottomTick"
                                                                 Grid.Row="2"
                                                                 Fill="#6B6B6B"
                                                                 Placement="Bottom"
                                                                 Height="8"
                                                                 Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="TickPlacement"
                                                                 Value="TopLeft">
                                                                <Setter TargetName="TopTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="TickPlacement"
                                                                 Value="BottomRight">
                                                                <Setter TargetName="BottomTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="TickPlacement"
                                                                 Value="Both">
                                                                <Setter TargetName="TopTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                                <Setter TargetName="BottomTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </Window.Resources>




        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main toolbar -->
                <Border Grid.Row="0"
                        Background="#F0F0F0"
                        Padding="10"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,0,0,1">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Load Base"
                                        Width="95"
                                        Margin="0,0,30,0"
                                        Click="LoadBaseFile_Click"/>

                                <TextBlock Grid.Column="1"
                                           Text="Page"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,5,0"/>

                                <TextBox x:Name="BasePageTextBox"
                                         Grid.Column="2"
                                         Text="1"
                                         Width="35"
                                         Margin="0,0,5,0"
                                         KeyDown="PageTextBox_KeyDown"/>

                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0">
                                           <Run Text="of "/>
                                           <Run x:Name="BasePageCount"
                                                Text="0"/>
                                </TextBlock>

                                <Button x:Name="PreviousPageButton"
                                        Grid.Column="4"
                                        Click="PreviousPage_Click"
                                        Padding="4,0"
                                        Margin="0,0,8,0">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 9 4.5 L 3 8 L 9 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>

                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <Button x:Name="NextPageButton"
                                        Grid.Column="5"
                                        Click="NextPage_Click"
                                        Padding="4,0"
                                        Margin="0,0,30,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 3 4.5 L 9 8 L 3 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                </Canvas>
                                        </Viewbox>

                                </Button>



                                <Button Content="Fit to Window"
                                        Grid.Column="6"
                                        Padding="5,0"
                                        Margin="0,0,30,0"
                                        HorizontalAlignment="Right"
                                        Click="FitToWindow_Click"/>

                                <!--Controls Below Not Visible-->

                                <TextBlock x:Name="DpiLabel"
                                           Grid.Column="8"
                                           Text="DPI"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0"
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="DpiControls"
                                            Grid.Column="9"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Width="130"
                                            Margin="0,0,12,0"
                                            Visibility="Collapsed">
                                        <Slider x:Name="DpiSlider"
                                                Width="100"
                                                Minimum="50"
                                                Maximum="450"
                                                Value="250"
                                                TickFrequency="25"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ProminentSliderStyle}"
                                                ValueChanged="MemoryControl_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=DpiSlider, Path=Value, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="#222222"/>
                                </StackPanel>

                                <TextBlock x:Name="PageCacheLabel"
                                           Grid.Column="10"
                                           Text="Page Cache"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0"
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="PageCacheControls"
                                            Grid.Column="11"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Width="130"
                                            Margin="0,0,12,0"
                                            Visibility="Collapsed">
                                        <Slider x:Name="CacheSizeSlider"
                                                Width="100"
                                                Minimum="0"
                                                Maximum="10"
                                                Value="5"
                                                TickFrequency="1"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ProminentSliderStyle}"
                                                ValueChanged="MemoryControl_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=CacheSizeSlider, Path=Value, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="#222222"/>
                                </StackPanel>
                                        
                                <TextBlock x:Name="SensitivityLabel"
                                           Grid.Column="12"
                                           Text="Sensitivity"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0"
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="SensitivityControls"
                                            Grid.Column="13"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Width="130"
                                            Margin="0,0,12,0"
                                            Visibility="Collapsed">
                                        <Slider x:Name="ImageThresholdSlider"
                                                Width="100"
                                                Minimum="25"
                                                Maximum="375"
                                                Value="200"
                                                TickFrequency="25"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ProminentSliderStyle}"
                                                ValueChanged="MemoryControl_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=ImageThresholdSlider, Path=Value, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="#222222"/>
                                </StackPanel>

                                <Button x:Name="AutoModeToggleButton"
                                        Grid.Column="16"
                                        Content="AUTO"
                                        Width="74"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Right"
                                        Click="AutoModeToggleButton_Click"/>

                        </Grid>
                </Border>
                <!-- Alignment controls -->
                <Border Grid.Row="1"
                        Background="#FAFAFA"
                        Padding="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="0,0,0,1">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Load Overlay"
                                        Width="95"
                                        Margin="0,0,30,0"
                                        Click="LoadOverlayFile_Click"/>

                                <TextBlock Grid.Column="1"
                                           Text="Page"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,5,0"/>

                                <TextBox x:Name="OverlayPageTextBox"
                                         Grid.Column="2"
                                         Text="1"
                                         Width="35"
                                         Margin="0,0,5,0"
                                         KeyDown="PageTextBox_KeyDown"/>

                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0">
                                           <Run Text="of "/>
                                           <Run x:Name="OverlayPageCount"
                                                Text="0"/>
                                </TextBlock>

                                <Button x:Name="PreviousPageOffsetButton"
                                        Grid.Column="4"
                                        Click="PreviousPageOffset_Click"
                                        Padding="4,0"
                                        Margin="0,0,10,0">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 9 4.5 L 3 8 L 9 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>

                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <Button x:Name="NextPageOffsetButton"
                                        Grid.Column="5"
                                        Click="NextPageOffset_Click"
                                        Padding="4,0"
                                        Margin="0,0,30,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 3 4.5 L 9 8 L 3 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <TextBlock Grid.Column="6"
                                           Text="Opacity"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Slider Grid.Column="7"
                                        x:Name="OpacitySlider"
                                        Width="150"
                                        Margin="0,0,20,0"
                                        Minimum="-100"
                                        Maximum="100"
                                        Value="50"
                                        TickFrequency="10"
                                        TickPlacement="BottomRight"
                                        Ticks="50"
                                        IsSnapToTickEnabled="False"
                                        Style="{StaticResource ProminentSliderStyle}"
                                        ValueChanged="OverlayControl_ValueChanged"/>





                                <TextBlock Grid.Column="8"
                                           Text="Scale"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Slider Grid.Column="9"
                                        x:Name="ScaleSlider"
                                        Width="150"
                                        Margin="0,0,30,0"
                                        Minimum="75"
                                        Maximum="150"
                                        Value="100"
                                        TickFrequency="10"
                                        TickPlacement="BottomRight"
                                        Ticks="100"
                                        IsSnapToTickEnabled="False"
                                        Style="{StaticResource ProminentSliderStyle}"
                                        ValueChanged="OverlayControl_ValueChanged"/>

                                <Button Grid.Column="10"
                                        Content="Reset"
                                        Padding="5,0"
                                        Margin="00,0,30,0"
                                        Click="ResetOverlay_Click"/>

                                <CheckBox Grid.Column="11"
                                          x:Name="UseFilteredOverlayPickerCheckbox"
                                          Content="Overlay Only Revisions"
                                          IsChecked="False"
                                          VerticalAlignment="Center"/>

                                <CheckBox Grid.Column="12"
                                          x:Name="TintImagesCheckBox"
                                          Margin="20,0,0,0"
                                          Content="Tint"
                                          IsChecked="True"
                                          VerticalAlignment="Center"                                          Visibility="Collapsed"                                          Checked="TintImagesCheckBox_Changed"
                                          Unchecked="TintImagesCheckBox_Changed"/>

                                <TextBlock x:Name="MemoryUsageTextBlock"
                                           Grid.Column="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,0"
                                           Foreground="#222222"
                                           Text="Mem: 0.0 MB"/>

                                <!--Controls Below Not Visible-->

                                <TextBlock Text="X Offset"
                                           VerticalAlignment="Center"
                                           Margin="20,0,8,0"
                                           Visibility="Collapsed"/>

                                <Slider x:Name="XOffsetSlider"
                                        Minimum="-10000"
                                        Maximum="10000"
                                        Value="0"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"
                                        Visibility="Collapsed"/>

                                <TextBlock Text="Y Offset"
                                           VerticalAlignment="Center"
                                           Margin="20,0,8,0"
                                           Visibility="Collapsed"/>

                                <Slider x:Name="YOffsetSlider"
                                        Minimum="-3500"
                                        Maximum="3500"
                                        Value="0"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"
                                        Visibility="Collapsed"/>

                        </Grid>
                </Border>

                <!-- Viewer area -->
                <Border Grid.Row="2"
                        Background="#2B2B2B"
                        Padding="10">

                        <Grid>
                                <ScrollViewer x:Name="ViewerScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseLeftButtonDown="ViewerScrollViewer_MouseLeftButtonDown"
                                              PreviewMouseWheel="ViewerScrollViewer_PreviewMouseWheel"
                                              MouseLeftButtonUp="ViewerScrollViewer_MouseLeftButtonUp"
                                              MouseMove="ViewerScrollViewer_MouseMove">

                                        <Grid x:Name="OverlayHost"
                                              Background="White"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top">

                                        <Grid.LayoutTransform>
                                                <ScaleTransform x:Name="ViewerScaleTransform"
                                                                ScaleX="1"
                                                                ScaleY="1"/>
                                        </Grid.LayoutTransform>

                                        <!-- Bottom image -->
                                        <Image x:Name="BaseImage"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"/>

                                        <!-- Top image -->
                                        <Image x:Name="OverlayImage"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Opacity="0.5"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="OverlayImage_MouseLeftButtonDown"
                                               MouseLeftButtonUp="OverlayImage_MouseLeftButtonUp"
                                               MouseMove="OverlayImage_MouseMove">

                                                <Image.RenderTransform>
                                                        <TransformGroup>
                                                                <ScaleTransform x:Name="OverlayScaleTransform"
                                                                                ScaleX="1"
                                                                                ScaleY="1"/>

                                                                <TranslateTransform x:Name="OverlayTranslateTransform"
                                                                                    X="0"
                                                                                    Y="0"/>
                                                        </TransformGroup>
                                                </Image.RenderTransform>
                                        </Image>
                                </Grid>
                        </ScrollViewer>

                                <Border x:Name="ProcessingSpinner"
                                        Width="96"
                                        Height="96"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Panel.ZIndex="10">
                                        <Grid>
                                                <Ellipse Width="96"
                                                         Height="96"
                                                         Stroke="#4A90E2"
                                                         StrokeThickness="4"
                                                         Opacity="0.2"/>
                                                <Path Data="M 48 8 A 40 40 0 1 1 47.9 8"
                                                      Stroke="#4A90E2"
                                                      StrokeThickness="4"
                                                      StrokeStartLineCap="Round"/>
                                        </Grid>
                                </Border>
                        </Grid>
                </Border>

                <!-- Status bar -->
                <Border Grid.Row="3"
                        Background="#F0F0F0"
                        Padding="8"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,1,0,0">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           x:Name="StatusText"
                                           Text="Load base and overlay PDFs to begin."
                                           FontSize="13"/>
                                <TextBlock Grid.Column="2"
                                           Text="Files Loaded:"
                                           FontSize="13"/>
                                <TextBlock Grid.Column="3"
                                           x:Name="BaseFileName"
                                           Text="No Base File Loaded"
                                           FontSize="13"
                                           Foreground="LimeGreen"
                                           Margin="20,0,0,0"/>
                                <TextBlock Grid.Column="4"
                                           x:Name="OverlayFileName"
                                           Text="No Overlay File Loaded"
                                           FontSize="13"
                                           Foreground="Red"
                                           Margin="20,0,20,0"/>
                        </Grid>
                </Border>
        </Grid>
</Window>
