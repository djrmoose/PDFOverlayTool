<Window x:Class="PdfOverlayTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Compare Tool"
        Icon="/Resources/OCT.ico"
        Height="850"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        PreviewKeyDown="Window_PreviewKeyDown"
        ToolTipService.ShowOnDisabled="True">

        <Window.Resources>
                <!-- Warm brown control palette -->
                <Color x:Key="AccentColor">#7A5230</Color>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="AccentPressedBrush" Color="#5C3D24"/>
                <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDF9F4"/>
                <SolidColorBrush x:Key="ControlBorderBrush" Color="#C9B08A"/>
                <SolidColorBrush x:Key="ControlHoverBrush" Color="#F2E8DA"/>
                <SolidColorBrush x:Key="ControlPressedBrush" Color="#E3D3BF"/>
                <SolidColorBrush x:Key="TrackBrush" Color="#D6C6B3"/>
                <SolidColorBrush x:Key="TickBrush" Color="#A89278"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F0F0F0"/>
                <SolidColorBrush x:Key="ToolbarSecondaryBackgroundBrush" Color="#FAFAFA"/>
                <SolidColorBrush x:Key="PanelBorderBrush" Color="#CCCCCC"/>
                <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#2B2B2B"/>
                <SolidColorBrush x:Key="ProcessingTrackBrush" Color="#D8D8D8"/>
                <SolidColorBrush x:Key="AutoNormalBrush" Color="#FDF9F4"/>
                <SolidColorBrush x:Key="AutoReducedBrush" Color="#E8C98A"/>
                <SolidColorBrush x:Key="AutoRecoveryBrush" Color="#A8D5A2"/>
                <SolidColorBrush x:Key="BaseFileBrush" Color="LimeGreen"/>
                <SolidColorBrush x:Key="OverlayFileBrush" Color="Red"/>

                <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Circular thumb shared by the modern slider -->
                <Style x:Key="ModernThumbStyle" TargetType="Thumb">
                        <Setter Property="Width" Value="16"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                        <Ellipse x:Name="ThumbEllipse"
                                                                 Fill="{DynamicResource ControlBackgroundBrush}"
                                                                 Stroke="{DynamicResource AccentBrush}"
                                                                 StrokeThickness="2"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource ControlHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="ProminentSliderStyle"
                       TargetType="Slider">
                        <Setter Property="Foreground"
                                Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="MinHeight" Value="24"/>
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                                <Grid>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TickBar x:Name="TopTick"
                                                                 Grid.Row="0"
                                                                 Fill="{DynamicResource TickBrush}"
                                                                 Placement="Top"
                                                                 Height="4"
                                                                 Visibility="Collapsed"/>

                                                        <Border Grid.Row="1"
                                                                Height="4"
                                                                CornerRadius="2"
                                                                Background="{DynamicResource TrackBrush}"
                                                                VerticalAlignment="Center"/>

                                                        <Track x:Name="PART_Track"
                                                               Grid.Row="1">
                                                                <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                                                      Focusable="False"
                                                                                      IsTabStop="False">
                                                                                <RepeatButton.Template>
                                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                                                <Border Height="4"
                                                                                                        CornerRadius="2"
                                                                                                        Background="{DynamicResource AccentBrush}"
                                                                                                        VerticalAlignment="Center"/>
                                                                                        </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                        </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                                                      Focusable="False"
                                                                                      IsTabStop="False">
                                                                                <RepeatButton.Template>
                                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                                                <Border Background="Transparent"/>
                                                                                        </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                        </RepeatButton>
                                                                </Track.IncreaseRepeatButton>
                                                                <Track.Thumb>
                                                                        <Thumb Style="{StaticResource ModernThumbStyle}"/>
                                                                </Track.Thumb>
                                                        </Track>

                                                        <TickBar x:Name="BottomTick"
                                                                 Grid.Row="2"
                                                                 Fill="{DynamicResource TickBrush}"
                                                                 Placement="Bottom"
                                                                 Height="4"
                                                                 Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="TickPlacement"
                                                                 Value="TopLeft">
                                                                <Setter TargetName="TopTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="TickPlacement"
                                                                 Value="BottomRight">
                                                                <Setter TargetName="BottomTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="TickPlacement"
                                                                 Value="Both">
                                                                <Setter TargetName="TopTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                                <Setter TargetName="BottomTick"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Consistent hover help for all controls -->
                <Style TargetType="ToolTip">
                        <Setter Property="MaxWidth" Value="480"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="HasDropShadow" Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ToolTip">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="12,9"
                                                        MaxWidth="{TemplateBinding MaxWidth}">
                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="{TemplateBinding FontSize}"
                                                                   Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Readable help button (between default size and the prior oversized version) -->
                <Style x:Key="HelpButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Style>

                <Style x:Key="SettingsButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource HelpButtonStyle}">
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Content" Value="&#xE713;"/>
                </Style>

                <Style TargetType="CheckBox">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Style>

                <Style TargetType="Slider">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                </Style>

                <Style TargetType="TextBox">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Style>

                <Style TargetType="TextBlock">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                </Style>

                <Style TargetType="StackPanel">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                </Style>

                <Style TargetType="Border">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                </Style>
        </Window.Resources>




        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ToolbarBackgroundBrush}"
                        Padding="10"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="LoadBaseButton"
                                        Grid.Column="0"
                                        Content="Load Base"
                                        Width="110"
                                        Margin="0,0,12,0"
                                        ToolTip="Open the bottom (reference) PDF or image file."
                                        Click="LoadBaseFile_Click"/>

                                <TextBlock Grid.Column="1"
                                           Text="Page"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,5,0"/>

                                <TextBox x:Name="BasePageTextBox"
                                         Grid.Column="2"
                                         Text="1"
                                         Width="35"
                                         Margin="0,0,4,0"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Base page number. Press Enter to jump to this page."
                                         KeyDown="PageTextBox_KeyDown"/>

                                <TextBlock Grid.Column="3"
                                           Width="42"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           Margin="0,0,4,0">
                                           <Run Text="of "/>
                                           <Run x:Name="BasePageCount"
                                                Text="0"/>
                                </TextBlock>

                                <Button x:Name="PreviousPageButton"
                                        Grid.Column="4"
                                        Click="PreviousPage_Click"
                                        Padding="4,0"
                                        Margin="0,0,8,0"
                                        ToolTip="Previous page (moves both base and overlay together).">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 9 4.5 L 3 8 L 9 11.5"
                                                              Stroke="{DynamicResource TextBrush}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>

                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <Button x:Name="NextPageButton"
                                        Grid.Column="5"
                                        Click="NextPage_Click"
                                        Padding="4,0"
                                        Margin="0,0,12,0"
                                        ToolTip="Next page (moves both base and overlay together)."
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 3 4.5 L 9 8 L 3 11.5"
                                                              Stroke="{DynamicResource TextBrush}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                </Canvas>
                                        </Viewbox>

                                </Button>



                                <Button Content="Fit to Window"
                                        Grid.Column="6"
                                        Padding="5,0"
                                        Margin="0,0,12,0"
                                        ToolTip="Resize the view so the current page fits the window."
                                        HorizontalAlignment="Right"
                                        Click="FitToWindow_Click"/>

                                <!-- MANUAL mode controls (hidden in AUTO) -->

                                <TextBlock x:Name="DpiLabel"
                                           Grid.Column="8"
                                           Text="DPI"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           ToolTip="Rendering resolution. Higher is sharper but uses more memory. Default: 250. Your last value is remembered between sessions."
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="DpiControls"
                                            Grid.Column="9"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Width="128"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed">
                                        <Slider x:Name="DpiSlider"
                                                Width="100"
                                                Minimum="50"
                                                Maximum="450"
                                                Value="250"
                                                TickFrequency="25"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="True"
                                                ToolTip="Rendering resolution (DPI). Higher is sharper but uses more memory. Default: 250. Your last value is remembered between sessions."
                                                Style="{StaticResource ProminentSliderStyle}"
                                                ValueChanged="MemoryControl_ValueChanged"
                                                Thumb.DragStarted="MemorySlider_DragStarted"
                                                Thumb.DragCompleted="MemorySlider_DragCompleted"/>
                                        <TextBlock Text="{Binding ElementName=DpiSlider, Path=Value, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>

                                <TextBlock x:Name="PageCacheLabel"
                                           Grid.Column="10"
                                           Text="Page Cache"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           ToolTip="Neighbouring pages kept pre-rendered on each side of the current page. Default: 5. Your last value is remembered between sessions."
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="PageCacheControls"
                                            Grid.Column="11"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Width="120"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed">
                                        <Slider x:Name="CacheSizeSlider"
                                                Width="100"
                                                Minimum="0"
                                                Maximum="10"
                                                Value="5"
                                                TickFrequency="1"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="True"
                                                ToolTip="Pages pre-rendered on each side of the current page. Higher is faster paging but uses more memory. Default: 5. Your last value is remembered between sessions."
                                                Style="{StaticResource ProminentSliderStyle}"
                                                ValueChanged="MemoryControl_ValueChanged"
                                                Thumb.DragStarted="MemorySlider_DragStarted"
                                                Thumb.DragCompleted="MemorySlider_DragCompleted"/>
                                        <TextBlock Text="{Binding ElementName=CacheSizeSlider, Path=Value, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                        
                                <TextBlock x:Name="SensitivityLabel"
                                           Grid.Column="12"
                                           Text="Sensitivity"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           ToolTip="Black/white threshold when rendering pages. Default: 200. Your last value is remembered between sessions."
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="SensitivityControls"
                                            Grid.Column="13"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Width="128"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed">
                                        <Slider x:Name="ImageThresholdSlider"
                                                Width="100"
                                                Minimum="25"
                                                Maximum="275"
                                                Value="200"
                                                TickFrequency="25"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="False"
                                                ToolTip="Black/white threshold when rendering. Lower captures more detail; higher is stricter. Default: 200. Your last value is remembered between sessions."
                                                Style="{StaticResource ProminentSliderStyle}"
                                                ValueChanged="MemoryControl_ValueChanged"
                                                Thumb.DragStarted="MemorySlider_DragStarted"
                                                Thumb.DragCompleted="MemorySlider_DragCompleted"/>
                                        <TextBlock Text="{Binding ElementName=ImageThresholdSlider, Path=Value, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                                             
                                <StackPanel Grid.Column="16"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                        <StackPanel x:Name="AutoPerformanceReadout"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"
                                                    Visibility="Collapsed"
                                                    ToolTip="Current AUTO rendering settings (page cache and DPI adjust automatically under memory pressure).">
                                                <TextBlock Text="DPI:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Text="{Binding ElementName=DpiSlider, Path=Value, StringFormat={}{0:0}}"/>
                                                <TextBlock Text="Page Cache:"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,4,0"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Text="{Binding ElementName=CacheSizeSlider, Path=Value, StringFormat={}{0:0}}"/>
                                        </StackPanel>
                                        <Button x:Name="SettingsButton"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Open settings (color palette, reset preferences)."
                                                Click="SettingsButton_Click"/>
                                        <Button x:Name="HelpButton"
                                                Content="?"
                                                Style="{StaticResource HelpButtonStyle}"
                                                Margin="0,0,8,0"
                                                ToolTip="Open help and about this tool."
                                                Click="HelpButton_Click"/>
                                        <Button x:Name="AutoModeToggleButton"
                                                Content="AUTO"
                                                Width="92"
                                                ToolTip="AUTO steps quality down under memory pressure (DPI stays at 250 until cache reaches 3; last step splits cache then DPI). Amber = reducing; green = restoring. MANUAL exposes the sliders directly."
                                                Click="AutoModeToggleButton_Click"/>
                                </StackPanel>

                        </Grid>
                </Border>
                <!-- Alignment controls -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ToolbarSecondaryBackgroundBrush}"
                        Padding="10"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Button x:Name="LoadOverlayButton"
                                        Grid.Column="0"
                                        Content="Load Overlay"
                                        Width="110"
                                        Margin="0,0,12,0"
                                        ToolTip="Open the top (comparison) PDF or image file."
                                        Click="LoadOverlayFile_Click"/>

                                <TextBlock Grid.Column="1"
                                           Text="Page"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,5,0"/>

                                <TextBox x:Name="OverlayPageTextBox"
                                         Grid.Column="2"
                                         Text="1"
                                         Width="35"
                                         Margin="0,0,4,0"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Overlay page number. Press Enter to jump to this page."
                                         KeyDown="PageTextBox_KeyDown"/>

                                <TextBlock Grid.Column="3"
                                           Width="42"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           Margin="0,0,4,0">
                                           <Run Text="of "/>
                                           <Run x:Name="OverlayPageCount"
                                                Text="0"/>
                                </TextBlock>

                                <Button x:Name="PreviousPageOffsetButton"
                                        Grid.Column="4"
                                        Click="PreviousPageOffset_Click"
                                        Padding="4,0"
                                        Margin="0,0,8,0"
                                        ToolTip="Previous overlay page only (base page stays unchanged).">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 9 4.5 L 3 8 L 9 11.5"
                                                              Stroke="{DynamicResource TextBrush}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>

                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <Button x:Name="NextPageOffsetButton"
                                        Grid.Column="5"
                                        Click="NextPageOffset_Click"
                                        Padding="4,0"
                                        Margin="0,0,12,0"
                                        ToolTip="Next overlay page only (base page stays unchanged)."
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 3 4.5 L 9 8 L 3 11.5"
                                                              Stroke="{DynamicResource TextBrush}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <TextBlock Grid.Column="6"
                                           Text="Opacity"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           ToolTip="Fade the base (slider left) or overlay (slider right). Centre is equal weight. Default: 50 (centre). Your last value is remembered between sessions."/>

                                <Slider Grid.Column="7"
                                        x:Name="OpacitySlider"
                                        Width="120"
                                        Margin="0,0,12,0"
                                        Minimum="-100"
                                        Maximum="100"
                                        Value="50"
                                        TickFrequency="10"
                                        TickPlacement="BottomRight"
                                        Ticks="50"
                                        IsSnapToTickEnabled="False"
                                        ToolTip="Fade the base (left) or overlay (right). Centre is equal weight. Default: 50 (centre). Your last value is remembered between sessions."
                                        Style="{StaticResource ProminentSliderStyle}"
                                        ValueChanged="OverlayControl_ValueChanged"/>





                                <TextBlock Grid.Column="8"
                                           Text="Scale"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           ToolTip="Resize the overlay relative to the base (75&#8211;125%)."/>

                                <Slider Grid.Column="9"
                                        x:Name="ScaleSlider"
                                        Width="120"
                                        Margin="0,0,16,0"
                                        Minimum="75"
                                        Maximum="125"
                                        Value="100"
                                        SmallChange="0.5"
                                        LargeChange="5"
                                        TickFrequency="10"
                                        TickPlacement="BottomRight"
                                        Ticks="100"
                                        IsSnapToTickEnabled="False"
                                        ToolTip="Resize the overlay relative to the base (75&#8211;125%)."
                                        Style="{StaticResource ProminentSliderStyle}"
                                        ValueChanged="OverlayControl_ValueChanged"/>

                                <StackPanel Grid.Column="10"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,0"
                                            ToolTip="Rotate the overlay in 90&#176; steps or fine-tune by up to &#177;5&#176; for skewed scans.">
                                        <Button x:Name="RotateCwButton"
                                                Content="&#x27F3;"
                                                FontSize="14"
                                                Padding="4,0"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Rotate overlay 90&#176; clockwise"
                                                Click="RotateCw_Click"/>
                                        <Slider x:Name="RotateFineSlider"
                                                Width="90"
                                                Minimum="-5"
                                                Maximum="5"
                                                Value="0"
                                                TickFrequency="1"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="False"
                                                ToolTip="Fine rotation (&#177;5&#176;) for skewed scans"
                                                Style="{StaticResource ProminentSliderStyle}"
                                                ValueChanged="OverlayControl_ValueChanged"/>
                                        <TextBlock x:Name="RotateAngleText"
                                                   Text="0.0&#176;"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32"
                                                   Margin="4,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="11"
                                        Content="Reset"
                                        Padding="8,0"
                                        Margin="0,0,16,0"
                                        ToolTip="Reset opacity, scale, position, and rotation to defaults."
                                        Click="ResetOverlay_Click"/>

                                <CheckBox Grid.Column="12"
                                          x:Name="UseFilteredOverlayPickerCheckbox"
                                          Content="Revs Only"
                                          IsChecked="False"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          ToolTip="When loading overlay, only list files that share the base file's name prefix."
                                          Checked="UseFilteredOverlayPickerCheckbox_Changed"
                                          Unchecked="UseFilteredOverlayPickerCheckbox_Changed"/>

                                <CheckBox Grid.Column="13"
                                          x:Name="TintImagesCheckBox"
                                          Margin="0,0,12,0"
                                          Content="Tint"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"
                                          ToolTip="Colour-code the base and overlay (green/red by default; blue/orange when color-blind friendly is enabled in Settings) to highlight differences."
                                          Checked="TintImagesCheckBox_Changed"
                                          Unchecked="TintImagesCheckBox_Changed"/>

                                <TextBlock x:Name="MemoryUsageTextBlock"
                                           Grid.Column="15"
                                           VerticalAlignment="Center"
                                           Margin="0,0,2,2"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="Mem: 0.0 MB"
                                           ToolTip="App cache vs system RAM / overall system memory load. Hover for bitmap and PDF breakdown."/>

                                <!--Controls Below Not Visible-->

                                <TextBlock Text="X Offset"
                                           VerticalAlignment="Center"
                                           Margin="20,0,8,0"
                                           Visibility="Collapsed"/>

                                <Slider x:Name="XOffsetSlider"
                                        Minimum="-10000"
                                        Maximum="10000"
                                        Value="0"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"
                                        Visibility="Collapsed"/>

                                <TextBlock Text="Y Offset"
                                           VerticalAlignment="Center"
                                           Margin="20,0,8,0"
                                           Visibility="Collapsed"/>

                                <Slider x:Name="YOffsetSlider"
                                        Minimum="-3500"
                                        Maximum="3500"
                                        Value="0"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"
                                        Visibility="Collapsed"/>

                        </Grid>
                </Border>

                <!-- Viewer area -->
                <Border x:Name="ViewerBorder"
                        Grid.Row="2"
                        Background="{DynamicResource ViewerBackgroundBrush}"
                        Padding="10"
                        AllowDrop="True"
                        DragOver="Viewer_DragOver"
                        Drop="Viewer_Drop">

                        <Grid>
                                <ScrollViewer x:Name="ViewerScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseLeftButtonDown="ViewerScrollViewer_MouseLeftButtonDown"
                                              PreviewMouseWheel="ViewerScrollViewer_PreviewMouseWheel"
                                              MouseLeftButtonUp="ViewerScrollViewer_MouseLeftButtonUp"
                                              MouseMove="ViewerScrollViewer_MouseMove">

                                        <Grid x:Name="OverlayHost"
                                              Background="White"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top">

                                        <Grid.LayoutTransform>
                                                <ScaleTransform x:Name="ViewerScaleTransform"
                                                                ScaleX="1"
                                                                ScaleY="1"/>
                                        </Grid.LayoutTransform>

                                        <!-- Bottom image -->
                                        <Image x:Name="BaseImage"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               ToolTip="Base (reference) document layer."/>

                                        <!-- Top image -->
                                        <Image x:Name="OverlayImage"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Opacity="0.5"
                                               Cursor="Hand"
                                               ToolTipService.IsEnabled="False"
                                               MouseLeftButtonDown="OverlayImage_MouseLeftButtonDown"
                                               MouseLeftButtonUp="OverlayImage_MouseLeftButtonUp"
                                               MouseMove="OverlayImage_MouseMove">

                                                <Image.RenderTransform>
                                                        <TransformGroup>
                                                                <!-- Rotate, then scale: both pivot around the viewer center, then translate applies. -->
                                                                <RotateTransform x:Name="OverlayRotateTransform"
                                                                                 Angle="0"/>

                                                                <ScaleTransform x:Name="OverlayScaleTransform"
                                                                                ScaleX="1"
                                                                                ScaleY="1"/>

                                                                <TranslateTransform x:Name="OverlayTranslateTransform"
                                                                                    X="0"
                                                                                    Y="0"/>
                                                        </TransformGroup>
                                                </Image.RenderTransform>
                                        </Image>
                                </Grid>
                        </ScrollViewer>
                        </Grid>
                </Border>

                <!-- Status bar -->
                <Border Grid.Row="3"
                        Background="{DynamicResource ToolbarBackgroundBrush}"
                        Padding="8"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           x:Name="StatusText"
                                           Text="Load base and overlay PDFs to begin."
                                           FontSize="13"/>

                                <Grid x:Name="ProcessingSpinner"
                                      Grid.Column="1"
                                      Width="200"
                                      Height="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      ClipToBounds="True">
                                        <Border Background="{DynamicResource ProcessingTrackBrush}"
                                                CornerRadius="3"/>
                                        <Border Width="70"
                                                Height="6"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="3">
                                                <Border.RenderTransform>
                                                        <TranslateTransform x:Name="ProcessingSpinnerTransform"
                                                                            X="-70"/>
                                                </Border.RenderTransform>
                                        </Border>
                                </Grid>
                                <TextBlock Grid.Column="2"
                                           Text="Files Loaded:"
                                           FontSize="13"/>
                                <TextBlock Grid.Column="3"
                                           x:Name="BaseFileName"
                                           Text="No Base File Loaded"
                                           FontSize="13"
                                           Foreground="{DynamicResource BaseFileBrush}"
                                           Margin="20,0,0,0"/>
                                <TextBlock Grid.Column="4"
                                           x:Name="OverlayFileName"
                                           Text="No Overlay File Loaded"
                                           FontSize="13"
                                           Foreground="{DynamicResource OverlayFileBrush}"
                                           Margin="20,0,20,0"/>
                        </Grid>
                </Border>

                <Border x:Name="StartupLogoOverlay"
                        Grid.RowSpan="4"
                        Panel.ZIndex="1000"
                        Visibility="Visible"
                        Opacity="0"
                        Background="{DynamicResource ToolbarBackgroundBrush}">
                        <Image Source="/Resources/Bluemoose.png"
                               Height="220"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
        </Grid>
</Window>
