<Window x:Class="PdfOverlayTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Compare Tool"
        Height="850"
        Width="1200"
        MinHeight="600"
        MinWidth="900">

        <Window.Resources>
                <Style TargetType="Button">
                        <Style.Triggers>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.4"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>
        </Window.Resources>




        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main toolbar -->
                <Border Grid.Row="0"
                        Background="#F0F0F0"
                        Padding="10"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,0,0,1">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Load Base"
                                        Width="80"
                                        Margin="0,0,20,0"
                                        Click="LoadBaseFile_Click"/>

                                <TextBlock Grid.Column="1"
                                           Text="Page"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,5,0"/>

                                <TextBox x:Name="BasePageTextBox"
                                         Grid.Column="2"
                                         Text="1"
                                         Width="35"
                                         Margin="0,0,5,0"
                                         KeyDown="PageTextBox_KeyDown"/>

                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0">
                                           <Run Text="of "/>
                                           <Run x:Name="BasePageCount"
                                                Text="0"/>
                                </TextBlock>

                                <Button x:Name="PreviousPageButton"
                                        Grid.Column="4"
                                        Click="PreviousPage_Click"
                                        Padding="4,0"
                                        Margin="0,0,10,0">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 9 4.5 L 3 8 L 9 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>

                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <Button x:Name="NextPageButton"
                                        Grid.Column="5"
                                        Click="NextPage_Click"
                                        Padding="4,0"
                                        Margin="0,0,20,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 3 4.5 L 9 8 L 3 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                </Canvas>
                                        </Viewbox>

                                </Button>



                                <Button Content="Fit to Window"
                                        Grid.Column="6"
                                        Padding="5,0"
                                        Margin="0,0,20,0"
                                        HorizontalAlignment="Right"
                                        Click="FitToWindow_Click"/>

                                <!--Controls Below Not Visible-->

                                <CheckBox x:Name="TintImagesCheckBox"
                                          Grid.Column="7"
                                          Margin="0,0,10,0"
                                          Content="Tint"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Checked="TintImagesCheckBox_Changed"
                                          Unchecked="TintImagesCheckBox_Changed"/>



                        </Grid>
                </Border>
                <!-- Alignment controls -->
                <Border Grid.Row="1"
                        Background="#FAFAFA"
                        Padding="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="0,0,0,1">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Load Overlay"
                                        Width="80"
                                        Margin="0,0,20,0"
                                        Click="LoadOverlayFile_Click"/>

                                <TextBlock Grid.Column="1"
                                           Text="Page"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,5,0"/>

                                <TextBox x:Name="OverlayPageTextBox"
                                         Grid.Column="2"
                                         Text="1"
                                         Width="35"
                                         Margin="0,0,5,0"
                                         KeyDown="PageTextBox_KeyDown"/>

                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0">
                                           <Run Text="of "/>
                                           <Run x:Name="OverlayPageCount"
                                                Text="0"/>
                                </TextBlock>

                                <Button x:Name="PreviousPageOffsetButton"
                                        Grid.Column="4"
                                        Click="PreviousPageOffset_Click"
                                        Padding="4,0"
                                        Margin="0,0,10,0">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 9 4.5 L 3 8 L 9 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>

                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <Button x:Name="NextPageOffsetButton"
                                        Grid.Column="5"
                                        Click="NextPageOffset_Click"
                                        Padding="4,0"
                                        Margin="0,0,20,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">

                                        <Viewbox Width="12"
                                                 Height="16"
                                                 Stretch="Uniform">
                                                <Canvas Width="12"
                                                        Height="16">
                                                        <Path Data="M 3 4.5 L 9 8 L 3 11.5"
                                                              Stroke="Black"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                </Canvas>
                                        </Viewbox>

                                </Button>

                                <TextBlock Grid.Column="6"
                                           Text="Opacity"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>

                                <Slider Grid.Column="7"
                                        x:Name="OpacitySlider"
                                        Width="150"
                                        Minimum="-100"
                                        Maximum="100"
                                        Value="50"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"/>





                                <TextBlock Grid.Column="8"
                                           Text="Scale"
                                           VerticalAlignment="Center"
                                           Margin="20,0,8,0"/>

                                <Slider Grid.Column="9"
                                        x:Name="ScaleSlider"
                                        Width="150"
                                        Minimum="10"
                                        Maximum="300"
                                        Value="100"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"/>

                                <Button Grid.Column="10"
                                        Content="Reset"
                                        Padding="5,0"
                                        Margin="20,0,20,0"
                                        Click="ResetOverlay_Click"/>

                                <CheckBox Grid.Column="11"
                                          x:Name="UseFilteredOverlayPickerCheckbox"
                                          Content="Overlay Only Revisions"
                                          IsChecked="False"
                                          VerticalAlignment="Center"/>

                                <!--Controls Below Not Visible-->

                                <TextBlock Text="X Offset"
                                           VerticalAlignment="Center"
                                           Margin="20,0,8,0"
                                           Visibility="Collapsed"/>

                                <Slider x:Name="XOffsetSlider"
                                        Minimum="-10000"
                                        Maximum="10000"
                                        Value="0"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"
                                        Visibility="Collapsed"/>

                                <TextBlock Text="Y Offset"
                                           VerticalAlignment="Center"
                                           Margin="20,0,8,0"
                                           Visibility="Collapsed"/>

                                <Slider x:Name="YOffsetSlider"
                                        Minimum="-3500"
                                        Maximum="3500"
                                        Value="0"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="OverlayControl_ValueChanged"
                                        Visibility="Collapsed"/>

                        </Grid>
                </Border>

                <!-- Viewer area -->
                <Border Grid.Row="2"
                        Background="#2B2B2B"
                        Padding="10">

                        <ScrollViewer x:Name="ViewerScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseLeftButtonDown="ViewerScrollViewer_MouseLeftButtonDown"
                                      PreviewMouseWheel="ViewerScrollViewer_PreviewMouseWheel"
                                      MouseLeftButtonUp="ViewerScrollViewer_MouseLeftButtonUp"
                                      MouseMove="ViewerScrollViewer_MouseMove">

                                <Grid x:Name="OverlayHost"
                                      Background="White"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top">

                                        <Grid.LayoutTransform>
                                                <ScaleTransform x:Name="ViewerScaleTransform"
                                                                ScaleX="1"
                                                                ScaleY="1"/>
                                        </Grid.LayoutTransform>

                                        <!-- Bottom image -->
                                        <Image x:Name="BaseImage"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"/>

                                        <!-- Top image -->
                                        <Image x:Name="OverlayImage"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Opacity="0.5"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="OverlayImage_MouseLeftButtonDown"
                                               MouseLeftButtonUp="OverlayImage_MouseLeftButtonUp"
                                               MouseMove="OverlayImage_MouseMove">

                                                <Image.RenderTransform>
                                                        <TransformGroup>
                                                                <ScaleTransform x:Name="OverlayScaleTransform"
                                                                                ScaleX="1"
                                                                                ScaleY="1"/>

                                                                <TranslateTransform x:Name="OverlayTranslateTransform"
                                                                                    X="0"
                                                                                    Y="0"/>
                                                        </TransformGroup>
                                                </Image.RenderTransform>
                                        </Image>
                                </Grid>
                        </ScrollViewer>
                </Border>

                <!-- Status bar -->
                <Border Grid.Row="3"
                        Background="#F0F0F0"
                        Padding="8"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,1,0,0">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           x:Name="StatusText"
                                           Text="Load base and overlay PDFs to begin."
                                           FontSize="13"/>
                                <TextBlock Grid.Column="2"
                                           Text="Files Loaded:"
                                           FontSize="13"/>
                                <TextBlock Grid.Column="3"
                                           x:Name="BaseFileName"
                                           Text="No Base File Loaded"
                                           FontSize="13"
                                           Foreground="LimeGreen"
                                           Margin="20,0,0,0"/>
                                <TextBlock Grid.Column="4"
                                           x:Name="OverlayFileName"
                                           Text="No Overlay File Loaded"
                                           FontSize="13"
                                           Foreground="Red"
                                           Margin="20,0,20,0"/>
                        </Grid>
                </Border>
        </Grid>
</Window>
