<Window x:Class="PdfOverlayTool.ThirdPartyNoticesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Third-Party Notices"
        Icon="/Resources/OCT.ico"
        Width="640"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="HelpTextBrush" Color="#4A3F35"/>
                <SolidColorBrush x:Key="PanelBorderBrush" Color="#C4B5A3"/>
                <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDF9F4"/>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="20,16,20,8"
                           FontSize="14"
                           Foreground="{DynamicResource HelpTextBrush}"
                           TextWrapping="Wrap"
                           Text="Overlay Compare Tool includes open-source components. The following notices are provided as required by their licenses."/>

                <Border Grid.Row="1"
                        Margin="20,0,20,12"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Background="White">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="12">
                                <TextBlock x:Name="NoticesTextBlock"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource HelpTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                        </ScrollViewer>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        Padding="12,10"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Button Content="Close"
                                Width="90"
                                HorizontalAlignment="Right"
                                IsCancel="True"
                                IsDefault="True"/>
                </Border>
        </Grid>
</Window>
