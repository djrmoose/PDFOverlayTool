<Window x:Class="PdfOverlayTool.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Feedback"
        Icon="/Resources/OCT.ico"
        Width="480"
        Height="Auto"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="HelpTextBrush" Color="#4A3F35"/>
                <SolidColorBrush x:Key="PanelBorderBrush" Color="#C4B5A3"/>
                <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDF9F4"/>
        </Window.Resources>

        <Grid Margin="24">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="How do you like the Overlay Compare Tool?"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Text="Your feedback helps improve the beta. This prompt appears about once a week."
                           FontSize="13"
                           Foreground="{DynamicResource HelpTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <TextBlock Grid.Row="2"
                           Text="Overall impression"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6"/>

                <ComboBox x:Name="RatingComboBox"
                          Grid.Row="3"
                          Margin="0,0,0,16"
                          Padding="8,6"
                          SelectedIndex="0">
                        <ComboBoxItem Content="Great"/>
                        <ComboBoxItem Content="Good"/>
                        <ComboBoxItem Content="Okay"/>
                        <ComboBoxItem Content="Needs improvement"/>
                </ComboBox>

                <TextBlock Grid.Row="4"
                           Text="Feedback and suggestions"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="FeedbackTextBox"
                         Grid.Row="5"
                         MinHeight="100"
                         MaxHeight="160"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8"
                         Margin="0,0,0,16"
                         ToolTip="Optional — bugs, feature ideas, or anything else you'd like to share."/>

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button Content="Skip"
                                Width="90"
                                Margin="0,0,8,0"
                                IsCancel="True"
                                Click="SkipButton_Click"/>
                        <Button Content="Submit"
                                Width="90"
                                IsDefault="True"
                                Click="SubmitButton_Click"/>
                </StackPanel>
        </Grid>
</Window>
