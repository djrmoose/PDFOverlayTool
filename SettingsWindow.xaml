<Window x:Class="PdfOverlayTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"F3
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="/Resources/OCT.ico"
        Width="520"
        Height="Auto"
        SizeToContent="Height"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#F3EDE4">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="HelpTextBrush" Color="#4A3F35"/>
                <SolidColorBrush x:Key="PanelBorderBrush" Color="#C4B5A3"/>
                <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDF9F4"/>
                <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="FontSize" Value="13"/>
                </Style>
                <Style TargetType="RadioButton">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
                <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Margin" Value="0,8,0,0"/>
                </Style>
        </Window.Resources>

        <Grid Margin="24">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Settings"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1"
                           Text="Theme"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,4">
                        <RadioButton x:Name="StandardThemeRadio"
                                     GroupName="AppTheme"
                                     Content="Standard — warm brown controls"
                                     Checked="PaletteOption_Changed"/>
                        <RadioButton x:Name="BlueGreyThemeRadio"
                                     GroupName="AppTheme"
                                     Content="Blue / grey — cool blue and grey controls"
                                     Checked="PaletteOption_Changed"/>
                </StackPanel>

                <CheckBox x:Name="ColorBlindFriendlyCheckBox"
                          Grid.Row="3"
                          Content="Color-blind friendly comparison colors"
                          ToolTip="Use blue and orange overlay tints (Okabe–Ito palette) instead of green and red. Also adjusts AUTO mode indicator colors."
                          Checked="PaletteOption_Changed"
                          Unchecked="PaletteOption_Changed"/>

                <TextBlock Grid.Row="4"
                           FontSize="13"
                           Foreground="{DynamicResource HelpTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,8,0,20"
                           Text="The theme applies to the main window, toolbars, buttons, sliders, status bar, and dialogs. Document overlays use green and red by default; enable color-blind friendly comparison colors for blue and orange overlays instead."/>

                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button x:Name="ResetDefaultsButton"
                                Content="Reset All Settings to Default"
                                Margin="0,0,12,0"
                                Click="ResetDefaultsButton_Click"/>
                        <Button Content="Close"
                                Width="90"
                                IsCancel="True"
                                IsDefault="True"/>
                </StackPanel>
        </Grid>
</Window>
