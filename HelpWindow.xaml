<Window x:Class="PdfOverlayTool.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help &amp; About"
        Icon="/Resources/OCT.ico"
        Width="560"
        Height="620"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F3EDE4">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="HelpTextBrush" Color="#4A3F35"/>
                <SolidColorBrush x:Key="PanelBorderBrush" Color="#C4B5A3"/>
                <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDF9F4"/>
                <Style x:Key="SectionHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Margin" Value="0,14,0,4"/>
                </Style>
                <Style x:Key="HelpText" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="{StaticResource HelpTextBrush}"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="0,2,0,2"/>
                </Style>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,10,20,0">
                        <StackPanel>
                                <TextBlock Text="Overlay Compare Tool"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,10,0,2"/>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="Compare two revisions of a PDF or image by overlaying them. The base document is tinted green and the overlay red, so unchanged content reads as dark while additions and removals stand out in color."/>

                                <TextBlock Text="Loading Files" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Use the Load Base / Load Overlay buttons, or drag a PDF or image file onto the viewer: the left half loads it as the base, the right half as the overlay."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Supported formats: PDF, PNG, JPG, BMP, TIFF."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Revs Only filters the overlay picker to files sharing the base file's name prefix."/>

                                <TextBlock Text="Page Navigation" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Left / Right arrow keys or the &lt; &gt; buttons page both documents together."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; The &lt; &gt; buttons on the overlay row page only the overlay, to offset it from the base."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Type a page number and press Enter to jump. A red page number means the page change was rejected (no such page)."/>

                                <TextBlock Text="Aligning the Overlay" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Drag the overlay with the mouse to position it."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Ctrl + arrow keys nudge the overlay one pixel at a time for precise registration."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Scale resizes the overlay (75&#8211;150%). Opacity fades the base (left) or the overlay (right)."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; The &#10226; &#10227; buttons rotate the overlay in 90&#176; steps; the small slider adds &#177;5&#176; fine correction for skewed scans."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Reset returns opacity, scale, position, and rotation to neutral."/>

                                <TextBlock Text="Viewing" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Ctrl + mouse wheel zooms. Ctrl + drag pans the view."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Fit to Window sizes the current page to the viewer."/>

                                <TextBlock Text="Performance (AUTO / MANUAL)" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; In AUTO mode the app manages memory itself: when usage stays high it reduces the page cache, then rendering DPI (amber button). When settings are below defaults and memory has significant headroom, it slowly restores cache and DPI toward defaults (green button)."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; MANUAL mode exposes the DPI, Page Cache, and Sensitivity sliders. Higher DPI is sharper but uses more memory; Page Cache controls how many neighbouring pages are pre-rendered; Sensitivity sets the black/white threshold."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; The Mem readout shows cache usage / total system memory load. The bar at the bottom animates while pages are rendering."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Opacity, DPI, Page Cache, Sensitivity, Revs Only, color palette, and AUTO/MANUAL mode are saved automatically and restored the next time you open the app."/>

                                <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="Overlay Compare Tool &#8212; a WPF utility for visually comparing drawing and document revisions."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="Rendering: PDFtoImage / SkiaSharp."/>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,0">
                                        <Run Text="Feature requests and bug reports are welcome. Contact the developer at "/>
                                        <Hyperlink NavigateUri="mailto:djrmoose@gmail.com?subject=Overlay%20Compare%20Tool%20Feedback"
                                                   RequestNavigate="FeedbackEmailLink_RequestNavigate">djrmoose@gmail.com</Hyperlink>
                                        <Run Text="."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,16" Text="&#169; Bluemoose"/>
                        </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="{StaticResource ControlBackgroundBrush}"
                        Padding="12,10"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Button Content="Close"
                                Width="90"
                                HorizontalAlignment="Right"
                                IsCancel="True"
                                IsDefault="True"/>
                </Border>
        </Grid>
</Window>
