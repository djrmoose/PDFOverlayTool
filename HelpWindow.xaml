<Window x:Class="PdfOverlayTool.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help &amp; About"
        Icon="/Resources/OCT.ico"
        Width="560"
        Height="620"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="HelpTextBrush" Color="#4A3F35"/>
                <SolidColorBrush x:Key="PanelBorderBrush" Color="#C4B5A3"/>
                <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDF9F4"/>
                <Style x:Key="SectionHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Margin" Value="0,14,0,4"/>
                </Style>
                <Style x:Key="HelpText" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="{DynamicResource HelpTextBrush}"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="0,2,0,2"/>
                </Style>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,10,20,0">
                        <StackPanel>
                                <TextBlock Text="Overlay Compare Tool"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,10,0,2"/>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="Compare two revisions of a PDF or image by overlaying them. The base and overlay are tinted in contrasting colors (green/red by default; blue/orange optional in Settings) so unchanged content reads as dark while additions and removals stand out in color."/>

                                <TextBlock Text="Loading Files" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Use the Load Base / Load Overlay buttons, or drag a PDF or image file onto the viewer: the left half loads it as the base, the right half as the overlay."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Supported formats: PDF, PNG, JPG, BMP, TIFF."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Revs Only filters the overlay picker to files sharing the base file's name prefix (split at the revision separator in Settings; default _)."/>

                                <TextBlock Text="Page Navigation" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Left / Right arrow keys or the &lt; &gt; buttons page both documents together."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; The &lt; &gt; buttons on the overlay row page only the overlay, to offset it from the base."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Type a page number and press Enter to jump. A red page number means the page change was rejected (no such page)."/>

                                <TextBlock Text="Aligning the Overlay" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Drag the overlay with the mouse to position it."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Ctrl + arrow keys nudge the overlay one pixel at a time for precise registration."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Scale resizes the overlay (75&#8211;150%). Opacity fades the base (left) or the overlay (right)."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; The &#10227; button rotates the overlay in 90&#176; steps; the small slider adds &#177;5&#176; fine correction for skewed scans."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Reset returns opacity, scale, position, and rotation to neutral."/>

                                <TextBlock Text="Viewing" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Ctrl + mouse wheel zooms. Ctrl + drag pans the view."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Ctrl + Alt + mouse wheel adjusts overlay scale."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Fit to Window sizes the current page to the viewer."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Demo Tour (button below) loads the sample PDFs and walks through the main features step by step. You perform each action yourself."/>

                                <TextBlock Text="Performance (AUTO / MANUAL)" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; AUTO is the default. The top row shows the current DPI and Page Cache readout (no sliders). Under memory pressure, AUTO steps down through linked quality levels about every 2 seconds: Page Cache lowers first while DPI stays at 250 (5&#8594;4&#8594;3), then cache and DPI drop together (2/225, 1/200), and the last descent splits into cache to zero at 200 DPI, then DPI to 150. The AUTO button turns amber while reducing and green while restoring one level at a time when memory has headroom."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; MANUAL mode exposes the DPI, Page Cache, and Sensitivity sliders directly. Higher DPI is sharper but uses more memory; Page Cache controls how many neighbouring pages are pre-rendered on each side of the current page; Sensitivity sets the black/white threshold when rendering PDFs."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Mem shows total app memory (bitmap cache plus loaded PDF bytes) as a percentage of system RAM and in megabytes, followed by overall system memory load. Red values indicate high usage. The bar at the bottom animates while pages are rendering."/>
                                <TextBlock Style="{StaticResource HelpText}" Text="&#8226; Opacity, DPI, Page Cache, Sensitivity, Revs Only, revision separator, color palette, and AUTO/MANUAL mode are saved automatically and restored the next time you open the app."/>

                                <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,8">
                                        <Image Source="/Resources/Bluemoose.png"
                                               Height="36"
                                               Stretch="Uniform"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Top"
                                               ToolTip="© Bluemoose"/>
                                        <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource HelpText}"
                                                           FontWeight="SemiBold"
                                                           Text="© Bluemoose™"/>
                                                <TextBlock Style="{StaticResource HelpText}"
                                                           Text="Overlay Compare Tool — visually compare drawing and document revisions."/>
                                                <TextBlock Style="{StaticResource HelpText}"
                                                           Margin="0,4,0,0"
                                                           Text="© 2026 Bluemoose™. All rights reserved."/>
                                        </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="Rendering: PDFtoImage / SkiaSharp."/>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,16">
                                        <Run Text="Feature requests and bug reports are welcome. Contact the developer at "/>
                                        <Hyperlink NavigateUri="mailto:djrmoose@gmail.com?subject=Overlay%20Compare%20Tool%20Feedback"
                                                   RequestNavigate="FeedbackEmailLink_RequestNavigate">djrmoose@gmail.com</Hyperlink>
                                        <Run Text="."/>
                                </TextBlock>
                        </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        Padding="12,10"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <Button Content="Demo Tour"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        ToolTip="Load the sample PDFs and walk through the main features."
                                        Click="DemoTourButton_Click"/>
                                <Button Content="Close"
                                        Width="90"
                                        IsCancel="True"
                                        IsDefault="True"/>
                        </StackPanel>
                </Border>
        </Grid>
</Window>
