<Window x:Class="PdfOverlayTool.DemoOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome"
        Icon="/Resources/OCT.ico"
        Width="460"
        Height="Auto"
        SizeToContent="Height"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="HelpTextBrush" Color="#4A3F35"/>
        </Window.Resources>

        <Grid Margin="24">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Brought to you by © Bluemoose"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="{DynamicResource HelpTextBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1"
                           Text="Would you like to see the demo?"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2"
                           FontSize="13"
                           Foreground="{DynamicResource HelpTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,20"
                           Text="The demo loads the included sample PDFs and walks you through the main features — comparison tints, paging, alignment, zoom, and more."/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button Content="Skip"
                                Width="90"
                                Margin="0,0,8,0"
                                IsCancel="True"
                                Click="SkipButton_Click"/>
                        <Button Content="Show demo"
                                Width="100"
                                IsDefault="True"
                                Click="ShowDemoButton_Click"/>
                </StackPanel>
        </Grid>
</Window>
