<Window x:Class="PdfOverlayTool.DemoTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demo Tour"
        Icon="/Resources/OCT.ico"
        Width="420"
        Height="Auto"
        SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#F0F0F0">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="HelpTextBrush" Color="#4A3F35"/>
                <SolidColorBrush x:Key="PanelBorderBrush" Color="#C4B5A3"/>
                <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDF9F4"/>
        </Window.Resources>

        <Grid Margin="16">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StepIndicatorText"
                           Grid.Row="0"
                           FontSize="12"
                           Foreground="{DynamicResource HelpTextBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="StepTitleText"
                           Grid.Row="1"
                           Text="Welcome"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="StepBodyText"
                           Grid.Row="2"
                           FontSize="13"
                           Foreground="{DynamicResource HelpTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SkipButton"
                                Grid.Column="0"
                                Content="Exit tour"
                                Padding="10,4"
                                Click="SkipButton_Click"/>

                        <Button x:Name="BackButton"
                                Grid.Column="2"
                                Content="Back"
                                Width="72"
                                Margin="0,0,8,0"
                                Padding="10,4"
                                Click="BackButton_Click"/>

                        <Button x:Name="NextButton"
                                Grid.Column="3"
                                Content="Next"
                                Width="72"
                                Padding="10,4"
                                IsDefault="True"
                                Click="NextButton_Click"/>
                </Grid>
        </Grid>
</Window>
