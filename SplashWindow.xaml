<Window x:Class="PdfOverlayTool.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Compare Tool"
        Icon="/Resources/OCT.ico"
        Width="520"
        Height="Auto"
        SizeToContent="Height"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#7A5230"/>
                <SolidColorBrush x:Key="TextBrush" Color="#3A2E24"/>
                <SolidColorBrush x:Key="BodyBrush" Color="#4A3F35"/>
        </Window.Resources>

        <Grid Margin="24">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Row="0"
                           Text="Beta"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="BodyTextBlock"
                           Grid.Row="1"
                           FontSize="14"
                           Foreground="{DynamicResource BodyBrush}"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Margin="0,0,0,20"/>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button Content="Continue"
                                Width="100"
                                IsDefault="True"
                                IsCancel="True"/>
                </StackPanel>
        </Grid>
</Window>
